diff --git a/src/servers/power/ac_monitor.h b/src/servers/power/ac_monitor.h
--- a/src/servers/power/ac_monitor.h
+++ b/src/servers/power/ac_monitor.h
@@ -8,6 +8,8 @@ class ACMonitor : public PowerMonitor {
 	virtual ~ACMonitor();
 
 	virtual void HandleEvent(int fd);
+			status_t ReadStatus(uint8* status);
 
 	virtual const std::set<int>& FDs() const { return fFDs; }
 private:
diff --git a/src/servers/power/ac_monitor.cpp b/src/servers/power/ac_monitor.cpp
--- a/src/servers/power/ac_monitor.cpp
+++ b/src/servers/power/ac_monitor.cpp
@@ -7,6 +7,7 @@
 
 
 #include "ac_monitor.h"
+#include "power_settings.h"
 
 #include <Messenger.h>
 #include <Roster.h>
@@ -32,12 +33,26 @@ ACMonitor::~ACMonitor()
 void
 ACMonitor::HandleEvent(int fd)
 {
-	uint8 status;
-	if (read(fd, &status, 1) != 1)
-		return;
-
-	if (status == 1)
-		printf("ac status 1\n");
+	uint8 status = 0;
+	if (ReadStatus(&status) != B_OK)
+		return;
+
+	apply_scheduler_for_ac(status);
+}
+
+
+status_t
+ACMonitor::ReadStatus(uint8* status)
+{
+	if (status == NULL || fFDs.empty())
+		return B_ERROR;
+
+	int fd = *fFDs.begin();
+	if (read(fd, status, 1) != 1)
+		return B_ERROR;
+
+	return B_OK;
 }
diff --git a/src/servers/power/power_settings.h b/src/servers/power/power_settings.h
