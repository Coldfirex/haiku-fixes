diff --git a/src/servers/power/power_settings.cpp b/src/servers/power/power_settings.cpp
new file mode 100644
--- /dev/null
+++ b/src/servers/power/power_settings.cpp
@@ -0,0 +1,49 @@
+/*
+ * Copyright 2026, Alan Shearer, sakison@gmail.com
+ * Distributed under the terms of the MIT License.
+ */
+
+
+#include "power_settings.h"
+
+#include <File.h>
+#include <FindDirectory.h>
+#include <Message.h>
+#include <Path.h>
+
+#include <scheduler.h>
+
+
+static const char* kSettingsFile = "power_daemon";
+
+
+void
+apply_scheduler_for_ac(uint8 acStatus)
+{
+	bool onBattery = false;
+	bool keepOnAc = false;
+
+	BPath path;
+	if (find_directory(B_SYSTEM_SETTINGS_DIRECTORY, &path) != B_OK)
+		return;
+	path.Append(kSettingsFile);
+
+	BFile file(path.Path(), B_READ_ONLY);
+	if (file.InitCheck() != B_OK)
+		return;
+
+	BMessage settings;
+	if (settings.Unflatten(&file) != B_OK)
+		return;
+
+	if (settings.FindBool("on_battery", &onBattery) != B_OK || !onBattery)
+		return;
+
+	settings.FindBool("keep_on_ac", &keepOnAc);
+
+	// status 1 is AC online. Same check as the old ac status printf.
+	int32 mode = SCHEDULER_MODE_POWER_SAVING;
+	if (acStatus == 1 && !keepOnAc)
+		mode = SCHEDULER_MODE_LOW_LATENCY;
+
+	if (get_scheduler_mode() != mode)
+		set_scheduler_mode(mode);
+}
diff --git a/src/servers/power/power_daemon.cpp b/src/servers/power/power_daemon.cpp
--- a/src/servers/power/power_daemon.cpp
+++ b/src/servers/power/power_daemon.cpp
@@ -8,6 +8,7 @@
 #include "ac_monitor.h"
 #include "lid_monitor.h"
 #include "power_button_monitor.h"
+#include "power_settings.h"
 
 #include <Server.h>
 
@@ -18,6 +19,7 @@ class PowerManagementDaemon : public BServer {
 public:
 								PowerManagementDaemon();
 	virtual 					~PowerManagementDaemon();
+	virtual	void				MessageReceived(BMessage* message);
 private:
 			void				_EventLoop();
 	static	status_t			_EventLooper(void *arg);
@@ -26,6 +28,7 @@ private:
 			PowerMonitor*		fPowerMonitors[3];
 			uint32				fMonitorCount;
 
+			ACMonitor*			fACMonitor;
 			bool				fQuitRequested;
 };
 
@@ -40,7 +43,8 @@ int
 PowerManagementDaemon::PowerManagementDaemon()
 	:
 	BServer("application/x-vnd.Haiku-powermanagement", false, NULL),
-	fMonitorCount(0),
+	fMonitorCount(0),
+	fACMonitor(NULL),
 	fQuitRequested(false)
 {
 	PowerMonitor* powerButtonMonitor = new PowerButtonMonitor;
@@ -56,10 +60,18 @@ PowerManagementDaemon::PowerManagementDaemon()
 		delete lidMonitor;
 
 	PowerMonitor* acMonitor = new ACMonitor;
-	if (acMonitor->FDs().size() > 0)
+	if (acMonitor->FDs().size() > 0) {
 		fPowerMonitors[fMonitorCount++] = acMonitor;
-	else
+		fACMonitor = static_cast<ACMonitor*>(acMonitor);
+		uint8 status = 0;
+		if (fACMonitor->ReadStatus(&status) == B_OK)
+			apply_scheduler_for_ac(status);
+	} else
 		delete acMonitor;
 
 	fEventThread = spawn_thread(_EventLooper, "_power_daemon_event_loop_",
 		B_NORMAL_PRIORITY, this);
@@ -80,6 +92,18 @@ PowerManagementDaemon::~PowerManagementDaemon()
 }
 
 
+void
+PowerManagementDaemon::MessageReceived(BMessage* message)
+{
+	if (message->what == kMsgReloadPowerSettings && fACMonitor != NULL) {
+		uint8 status = 0;
+		if (fACMonitor->ReadStatus(&status) == B_OK)
+			apply_scheduler_for_ac(status);
+		return;
+	}
+	BServer::MessageReceived(message);
+}
+
+
 status_t
 PowerManagementDaemon::_EventLooper(void* arg)
 {
