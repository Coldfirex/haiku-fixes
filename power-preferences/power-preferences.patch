+/*
+ * Copyright 2026, Alan Shearer, sakison@gmail.com
+ * Distributed under the terms of the MIT License.
+ */
+#ifndef POWER_WINDOW_H
+#define POWER_WINDOW_H
+
+
+#include <Window.h>
+
+
+class BCheckBox;
+
+
+// Same code power_daemon handles. Do not change it on one side only.
+enum {
+	kMsgReloadPowerSettings = 'PwRl'
+};
+
+
+class PowerWindow : public BWindow {
+public:
+							PowerWindow();
+	virtual					~PowerWindow();
+
+	virtual	void			MessageReceived(BMessage* message);
+	virtual	bool			QuitRequested();
+
+private:
+			void			_LoadSettings();
+			void			_SaveSettings();
+			void			_UpdateEnabled();
+
+			BCheckBox*		fOnBattery;
+			BCheckBox*		fKeepOnAc;
+};
+
+#endif
diff --git a/src/preferences/power/PowerWindow.cpp b/src/preferences/power/PowerWindow.cpp
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/src/preferences/power/PowerWindow.cpp
@@ -0,0 +1,160 @@
+/*
+ * Copyright 2026, Alan Shearer, sakison@gmail.com
+ * Distributed under the terms of the MIT License.
+ */
+
+
+#include "PowerWindow.h"
+
+#include <Button.h>
+#include <Catalog.h>
+#include <CheckBox.h>
+#include <File.h>
+#include <FindDirectory.h>
+#include <LayoutBuilder.h>
+#include <Messenger.h>
+#include <Path.h>
+#include <StringView.h>
+
+
+#undef B_TRANSLATION_CONTEXT
+#define B_TRANSLATION_CONTEXT "Power"
+
+
+static const char* kSettingsFile = "power_daemon";
+static const uint32 kMsgOnBattery = 'OnBt';
+static const uint32 kMsgKeepOnAc = 'KpAc';
+
+
+PowerWindow::PowerWindow()
+	:
+	BWindow(BRect(0, 0, 100, 100), B_TRANSLATE_SYSTEM_NAME("Power"),
+		B_TITLED_WINDOW, B_NOT_ZOOMABLE | B_AUTO_UPDATE_SIZE_LIMITS
+			| B_QUIT_ON_WINDOW_CLOSE),
+	fOnBattery(NULL),
+	fKeepOnAc(NULL)
+{
+	fOnBattery = new BCheckBox("on_battery",
+		B_TRANSLATE("Power saving on battery"), new BMessage(kMsgOnBattery));
+	fKeepOnAc = new BCheckBox("keep_on_ac",
+		B_TRANSLATE("Keep power saving on AC"), new BMessage(kMsgKeepOnAc));
+
+	BStringView* note = new BStringView("note",
+		B_TRANSLATE("Used when the machine switches between battery and AC."));
+
+	BLayoutBuilder::Group<>(this, B_VERTICAL, B_USE_SMALL_SPACING)
+		.SetInsets(B_USE_WINDOW_SPACING)
+		.Add(fOnBattery)
+		.Add(fKeepOnAc)
+		.Add(note)
+		.End();
+
+	_LoadSettings();
+	_UpdateEnabled();
+	CenterOnScreen();
+}
+
+
+PowerWindow::~PowerWindow()
+{
+}
+
+
+void
+PowerWindow::MessageReceived(BMessage* message)
+{
+	switch (message->what) {
+		case kMsgOnBattery:
+		case kMsgKeepOnAc:
+			_UpdateEnabled();
+			_SaveSettings();
+			break;
+
+		default:
+			BWindow::MessageReceived(message);
+			break;
+	}
+}
+
+
+bool
+PowerWindow::QuitRequested()
+{
+	_SaveSettings();
+	return true;
+}
+
+
+void
+PowerWindow::_LoadSettings()
+{
+	bool onBattery = false;
+	bool keepOnAc = false;
+
+	BPath path;
+	if (find_directory(B_SYSTEM_SETTINGS_DIRECTORY, &path) == B_OK) {
+		path.Append(kSettingsFile);
+		BFile file(path.Path(), B_READ_ONLY);
+		BMessage settings;
+		if (file.InitCheck() == B_OK && settings.Unflatten(&file) == B_OK) {
+			settings.FindBool("on_battery", &onBattery);
+			settings.FindBool("keep_on_ac", &keepOnAc);
+		}
+	}
+
+	fOnBattery->SetValue(onBattery ? B_CONTROL_ON : B_CONTROL_OFF);
+	fKeepOnAc->SetValue(keepOnAc ? B_CONTROL_ON : B_CONTROL_OFF);
+}
+
+
+void
+PowerWindow::_SaveSettings()
+{
+	BMessage settings;
+	settings.AddBool("on_battery", fOnBattery->Value() == B_CONTROL_ON);
+	settings.AddBool("keep_on_ac", fKeepOnAc->Value() == B_CONTROL_ON);
+
+	BPath path;
+	if (find_directory(B_SYSTEM_SETTINGS_DIRECTORY, &path) != B_OK)
+		return;
+	path.Append(kSettingsFile);
+
+	BFile file(path.Path(), B_WRITE_ONLY | B_CREATE_FILE | B_ERASE_FILE);
+	if (file.InitCheck() != B_OK)
+		return;
+	if (settings.Flatten(&file) != B_OK)
+		return;
+
+	BMessenger daemon("application/x-vnd.Haiku-powermanagement");
+	if (daemon.IsValid())
+		daemon.SendMessage(kMsgReloadPowerSettings);
+}
+
+
+void
+PowerWindow::_UpdateEnabled()
+{
+	fKeepOnAc->SetEnabled(fOnBattery->Value() == B_CONTROL_ON);
+}
