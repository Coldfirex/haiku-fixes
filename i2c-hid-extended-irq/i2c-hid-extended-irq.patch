+{
+	extended_irq* irq = static_cast<extended_irq*>(context);
+	if (irq->found || resource->Type != ACPI_RESOURCE_TYPE_EXTENDED_IRQ)
+		return AE_OK;
+
+	ACPI_RESOURCE_EXTENDED_IRQ& ext = resource->Data.ExtendedIrq;
+	if (ext.InterruptCount == 0)
+		return AE_OK;
