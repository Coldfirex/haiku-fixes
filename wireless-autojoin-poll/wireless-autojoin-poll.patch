From: Alan Shearer <alan@example.com>
Date: Thu, 22 Oct 2026 14:50:00 -0500
Subject: [PATCH] net_server: poll for scan results to start auto-join

The WLAN_SCANNED notification is not always delivered, so the
auto-join path never runs on boot. Request a scan and then check
the results directly.

---
 src/servers/net/AutoconfigLooper.cpp | 22 ++++++++++++++++++++++
 1 file changed, 22 insertions(+)

diff --git a/src/servers/net/AutoconfigLooper.cpp b/src/servers/net/AutoconfigLooper.cpp
--- a/src/servers/net/AutoconfigLooper.cpp
+++ b/src/servers/net/AutoconfigLooper.cpp
@@ -18,6 +18,7 @@
 #include <sys/sockio.h>
 
 #include <NetworkInterface.h>
+#include <NetworkDevice.h>
 #include <NetworkNotifications.h>
 
 #include "DHCPClient.h"
@@ -120,8 +121,29 @@ AutoconfigLooper::_ReadyToRun()
 		// Also make sure we don't spuriously try to configure again from
 		// a link changed notification that might race us.
 		fLastMediaStatus |= IFM_ACTIVE;
+		return;
 	}
+
+	// No link yet. The WLAN_SCANNED notification does not always
+	// arrive, so request a scan and check the results ourselves.
+	BNetworkDevice device(fDevice.String());
+	if (!device.IsWireless())
+		return;
+
+	device.Scan(false);
+	snooze(3000000);
+
+	wireless_network* networks = NULL;
+	uint32 count = 0;
+	if (device.GetNetworks(networks, count) == B_OK && count > 0) {
+		BMessage message(kMsgAutoJoinNetwork);
+		message.AddString("device", fDevice);
+		fTarget.SendMessage(&message);
+		delete[] networks;
+	}
 }
 
 
