From: Alan Shearer
Subject: tcp: free error buffer in error_received

icmp_receive_data transfers the quoted packet to TCP error_received.
tcp_error_received() never took ownership: it returned on a missing
domain, a failed header read, a short header, no endpoint manager, or
no matching connection without freeing. TCPEndpoint::ErrorReceived()
only updates MSS and also leaves the buffer alone.

Free the buffer on every exit. ErrorReceived does not queue it.

---
 src/add-ons/kernel/network/protocols/tcp/tcp.cpp | 18 +++++++++++++-----
 1 file changed, 13 insertions(+), 5 deletions(-)

diff --git a/src/add-ons/kernel/network/protocols/tcp/tcp.cpp b/src/add-ons/kernel/network/protocols/tcp/tcp.cpp
--- a/src/add-ons/kernel/network/protocols/tcp/tcp.cpp
+++ b/src/add-ons/kernel/network/protocols/tcp/tcp.cpp
@@ -762,8 +762,10 @@
 	TRACE(("TCP: Received error %d\n", error));
 
 	if (data->interface_address == NULL
-		|| data->interface_address->domain == NULL)
+		|| data->interface_address->domain == NULL) {
+		gBufferModule->free(data);
 		return B_ERROR;
+	}
 
 	net_domain* domain = data->interface_address->domain;
 	net_address_module_info* addressModule = domain->address_module;
@@ -770,14 +772,18 @@
 
 	NetBufferHeaderReader<tcp_header> bufferHeader(data);
-	if (bufferHeader.Status() < B_OK)
+	if (bufferHeader.Status() < B_OK) {
+		gBufferModule->free(data);
 		return bufferHeader.Status();
+	}
 
 	tcp_header& header = bufferHeader.Data();
 
 	uint16 headerLength = header.HeaderLength();
-	if (headerLength < sizeof(tcp_header))
+	if (headerLength < sizeof(tcp_header)) {
+		gBufferModule->free(data);
 		return B_BAD_DATA;
+	}
 
 	EndpointManager* endpointManager = endpoint_manager_for(domain);
-	if (endpointManager == NULL)
+	if (endpointManager == NULL) {
+		gBufferModule->free(data);
 		return B_ERROR;
+	}
 
 	addressModule->set_port(data->source, header.source_port);
 	addressModule->set_port(data->destination, header.destination_port);
@@ -791,11 +797,13 @@
 		TRACE(("  Endpoint not found for: peer %s, local %s\n",
 			AddressString(domain, data->destination, true).Data(),
 			AddressString(domain, data->source, true).Data()));
+		gBufferModule->free(data);
 		return B_ERROR;
 	}
 
 	status_t status = endpoint->ErrorReceived(error, errorData, data);
 
 	gSocketModule->release_socket(endpoint->socket);
+	gBufferModule->free(data);
 	return status;
 }
