From: Alan Shearer
Subject: tcp: abort the child if _Spawn fails

The new socket is already on the pending connection queue when
_Spawn runs. If open, bind, the send path, or the SYN-ACK fails,
we just return DROP and leave that child sitting there.

_Spawn has a TODO for proper error handling. This is that handling.
Set CLOSED on the later failures and trace the state change.
After _Spawn returns, abort the socket if it is CLOSED.

--- a/src/add-ons/kernel/network/protocols/tcp/TCPEndpoint.cpp	2026-11-27 15:22:23.639211973 +0000
+++ b/src/add-ons/kernel/network/protocols/tcp/TCPEndpoint.cpp	2026-11-27 15:22:28.367211973 +0000
@@ -1620,7 +1620,6 @@
 	// Reset local address, so we don't end up with an invalid address in case of failure
 	(*LocalAddress())->sa_len = 0;
 
-	// TODO: proper error handling!
 	if (ProtocolSocket::Open() != B_OK) {
 		T(Error(this, "opening failed", __LINE__));
 		return DROP;
@@ -1633,10 +1632,14 @@
 
 	if (fManager->BindChild(this, buffer->destination) != B_OK) {
 		T(Error(this, "binding failed", __LINE__));
+		fState = CLOSED;
+		T(State(this));
 		return DROP;
 	}
 	if (_PrepareSendPath(buffer->source) != B_OK) {
 		T(Error(this, "prepare send faild", __LINE__));
+		fState = CLOSED;
+		T(State(this));
 		return DROP;
 	}
 
@@ -1694,8 +1697,12 @@
 		return DROP;
 	}
 
-	return ((TCPEndpoint *)newSocket->first_protocol)->_Spawn(this,
-		segment, buffer);
+	TCPEndpoint* child = (TCPEndpoint*)newSocket->first_protocol;
+	int32 action = child->_Spawn(this, segment, buffer);
+	// Defer set_aborted() until the child lock is released.
+	if (child->State() == CLOSED)
+		gSocketModule->set_aborted(newSocket);
+	return action;
 }
 
 
