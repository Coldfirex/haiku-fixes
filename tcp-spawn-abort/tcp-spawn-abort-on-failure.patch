From: Alan Shearer
Subject: tcp: drop child socket if _Spawn fails

The child is already on the listen queue before _Spawn runs.
If open, bind, or the SYN-ACK fails, _Spawn returns DROP and
leaves that child sitting there.

Set CLOSED on the later failures. After _Spawn returns, abort
if the child is CLOSED.

Do not abort inside _Spawn. It still holds the child's lock.

---
 src/add-ons/kernel/network/protocols/tcp/TCPEndpoint.cpp | 14 +++++++++++---
 1 file changed, 11 insertions(+), 3 deletions(-)

diff --git a/src/add-ons/kernel/network/protocols/tcp/TCPEndpoint.cpp b/src/add-ons/kernel/network/protocols/tcp/TCPEndpoint.cpp
--- a/src/add-ons/kernel/network/protocols/tcp/TCPEndpoint.cpp
+++ b/src/add-ons/kernel/network/protocols/tcp/TCPEndpoint.cpp
@@ -1552,7 +1552,9 @@
 
 	TRACE("Spawn()");
 
-	// TODO: proper error handling!
+	// Do not call set_aborted() here: we still hold fLock, and the
+	// destructor would take the same lock.
 	if (ProtocolSocket::Open() != B_OK) {
 		T(Error(this, "opening failed", __LINE__));
 		return DROP;
@@ -1565,10 +1567,12 @@
 
 	if (fManager->BindChild(this, buffer->destination) != B_OK) {
 		T(Error(this, "binding failed", __LINE__));
+		fState = CLOSED;
 		return DROP;
 	}
 	if (_PrepareSendPath(buffer->source) != B_OK) {
 		T(Error(this, "prepare send faild", __LINE__));
+		fState = CLOSED;
 		return DROP;
 	}
 
@@ -1580,6 +1584,7 @@
 	// send SYN+ACK
 	if (_SendAcknowledge() != B_OK) {
 		T(Error(this, "sending failed", __LINE__));
+		fState = CLOSED;
 		return DROP;
 	}
 
@@ -1613,8 +1618,12 @@
 		return DROP;
 	}
 
-	return ((TCPEndpoint *)newSocket->first_protocol)->_Spawn(this,
-		segment, buffer);
+	TCPEndpoint* child = (TCPEndpoint*)newSocket->first_protocol;
+	int32 action = child->_Spawn(this, segment, buffer);
+	if (child->State() == CLOSED)
+		gSocketModule->set_aborted(newSocket);
+	return action;
 }
 
 
