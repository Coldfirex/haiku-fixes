From: Alan Shearer
Subject: arp: free queued packets if send fails

When the MAC is known we send the packets that were waiting.
If send_data fails it does not take the buffer, so free it.

If there is no protocol, just drop the queue.

--- a/src/add-ons/kernel/network/datalink_protocols/arp/arp.cpp	2026-11-27 15:22:23.639211973 +0000
+++ b/src/add-ons/kernel/network/datalink_protocols/arp/arp.cpp	2026-11-27 15:22:44.271211973 +0000
@@ -339,6 +339,11 @@
 
 	flags = (flags & ~ARP_FLAG_REJECT) | ARP_FLAG_VALID;
 
+	if (protocol == NULL || protocol->next == NULL) {
+		ClearQueue();
+		return;
+	}
+
 	BufferList::Iterator iterator = queue.GetIterator();
 	while (iterator.HasNext()) {
 		net_buffer *buffer = iterator.Next();
@@ -348,7 +353,10 @@
 
 		memcpy(buffer->destination, &hardware_address,
 			hardware_address.sdl_len);
-		protocol->next->module->send_data(protocol->next, buffer);
+		status_t status = protocol->next->module->send_data(protocol->next,
+			buffer);
+		if (status < B_OK)
+			gBufferModule->free(buffer);
 	}
 }
 
