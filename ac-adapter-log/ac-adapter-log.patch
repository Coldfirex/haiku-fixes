From: Alan Shearer
Subject: power: log AC adapter and battery source changes

Unplugging the adapter does not add a syslog line. Two spots drop it.

acpi_ac only dprints the raw _PSR value behind its trace, and never
reads status at init. acpi_battery gets the status notify (0x80) that
most laptops actually send, but that trace is compiled out. power_daemon
opens /dev/power/acpi_ac/0 and printf's only when status is 1. A server
has no terminal, so that line never reaches syslog, and unplug is
skipped.

Log a source change from the battery notify after _BST, and from
acpi_ac when _PSR changes. power_daemon uses syslog() for both online
and offline.

Not Gerrit until an unplug shows the line.

--- a/src/add-ons/kernel/drivers/power/acpi_ac/acpi_ac.cpp
+++ b/src/add-ons/kernel/drivers/power/acpi_ac/acpi_ac.cpp
@@ -60,9 +60,13 @@
 		ERROR("couldn't get status\n");
 	} else {
 		acpi_object_type* object = (acpi_object_type*)buf.pointer;
-		device->last_status = object->integer.integer;
+		uint8 status = object->integer.integer;
+		if (!device->updated || status != device->last_status) {
+			dprintf("acpi_ac: AC adapter %s\n",
+				status != 0 ? "online" : "offline");
+		}
+		device->last_status = status;
 		device->updated = true;
-		TRACE("status %d\n", device->last_status);
 	}
 	free(buf.pointer);
 }
@@ -266,6 +270,9 @@
 	device->updated = false;
 	device->select_pool = NULL;
 
+	// so the first notify can tell a real change, and boot shows the source
+	acpi_ac_update_status(device);
+
 	*_driverCookie = device;
 	return B_OK;
 }
--- a/src/add-ons/kernel/drivers/power/acpi_battery/acpi_battery.cpp
+++ b/src/add-ons/kernel/drivers/power/acpi_battery/acpi_battery.cpp
@@ -26,6 +26,8 @@
 	device_node*				node;
 	acpi_device_module_info*	acpi;
 	acpi_device					acpi_cookie;
+	bool						have_source;
+	bool						on_battery;
 };
 
 
@@ -127,6 +129,28 @@
 }
 
 
+static void
+log_power_source(battery_driver_cookie* cookie)
+{
+	acpi_battery_info info;
+	if (ReadBatteryStatus(cookie, &info) != B_OK)
+		return;
+
+	// empty slot, not a plug event
+	if (info.capacity == UINT32_MAX && info.voltage == UINT32_MAX)
+		return;
+
+	// discharging is on battery. charging or idle is AC.
+	bool onBattery = (info.state & BATTERY_DISCHARGING) != 0;
+	if (cookie->have_source && cookie->on_battery == onBattery)
+		return;
+
+	cookie->have_source = true;
+	cookie->on_battery = onBattery;
+	dprintf("acpi_battery: %s\n", onBattery ? "on battery" : "on AC");
+}
+
+
 status_t
 ReadBatteryInfo(battery_driver_cookie* cookie,
 	acpi_extended_battery_info* batteryInfo)
@@ -258,6 +282,9 @@
 battery_notify_handler(acpi_handle device, uint32 value, void *context)
 {
 	TRACE("battery_notify_handler event 0x%x\n", int(value));
+	// 0x80 status, 0x81 info. capacity ticks stay quiet unless the source flips.
+	if (value == 0x80 || value == 0x81)
+		log_power_source((battery_driver_cookie*)context);
 	sBatteryCondition.NotifyAll();
 }
 
@@ -570,6 +597,7 @@
 	device->acpi->install_notify_handler(device->acpi_cookie,
     	ACPI_ALL_NOTIFY, battery_notify_handler, device);
 
+	log_power_source(device);
 	return B_OK;
 }
 
--- a/src/servers/power/ac_monitor.cpp
+++ b/src/servers/power/ac_monitor.cpp
@@ -12,6 +12,7 @@
 #include <Roster.h>
 
 #include <stdio.h>
+#include <syslog.h>
 
 
 ACMonitor::ACMonitor()
@@ -36,6 +37,6 @@
 	if (read(fd, &status, 1) != 1)
 		return;
 
-	if (status == 1)
-		printf("ac status 1\n");
+	syslog(LOG_INFO, "AC adapter %s\n",
+		status == 1 ? "online" : "offline");
 }
