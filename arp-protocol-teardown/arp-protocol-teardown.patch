From: Alan Shearer
Subject: arp: undo handler register if init fails

Init registers the ARP handler, then the IPv4 handler, then
allocates the protocol. If a later step fails, the handlers
are left registered.

Uninit also deleted the protocol while cache entries still
pointed at it.

Unregister the handlers if init fails. On uninit, remove
cache entries that belong to this protocol.

---
 src/add-ons/kernel/network/datalink_protocols/arp/arp.cpp | 41 +++++++++++++++++++++++++++++++----------
 1 file changed, 31 insertions(+), 10 deletions(-)

diff --git a/src/add-ons/kernel/network/datalink_protocols/arp/arp.cpp b/src/add-ons/kernel/network/datalink_protocols/arp/arp.cpp
--- a/src/add-ons/kernel/network/datalink_protocols/arp/arp.cpp
+++ b/src/add-ons/kernel/network/datalink_protocols/arp/arp.cpp
@@ -534,6 +534,32 @@
 }
 
 
+static void
+arp_remove_protocol_entries(arp_protocol* protocol)
+{
+	MutexLocker locker(sCacheLock);
+
+	AddressCache::Iterator iterator(sCache);
+	while (iterator.HasNext()) {
+		arp_entry* entry = iterator.Next();
+		if (entry->protocol != protocol)
+			continue;
+
+		sCache->Remove(entry);
+		entry->flags |= ARP_FLAG_REMOVED;
+		entry->protocol = NULL;
+
+		locker.Unlock();
+		delete entry;
+		locker.Lock();
+
+		iterator = AddressCache::Iterator(sCache);
+	}
+}
+
+
 /*!	Creates permanent local entries for all addresses of the interface belonging
 	to this protocol.
 	Returns an error if no entry could be added.
@@ -986,11 +1012,19 @@
 	status = sStackModule->register_domain_device_handler(
 		interface->device, B_NET_FRAME_TYPE(IFT_ETHER, ETHER_TYPE_IP), domain);
-	if (status != B_OK)
+	if (status != B_OK) {
+		sStackModule->unregister_device_handler(interface->device,
+			B_NET_FRAME_TYPE(IFT_ETHER, ETHER_TYPE_ARP));
 		return status;
+	}
 
 	arp_protocol* protocol = new(std::nothrow) arp_protocol;
-	if (protocol == NULL)
+	if (protocol == NULL) {
+		sStackModule->unregister_device_handler(interface->device,
+			B_NET_FRAME_TYPE(IFT_ETHER, ETHER_TYPE_IP));
+		sStackModule->unregister_device_handler(interface->device,
+			B_NET_FRAME_TYPE(IFT_ETHER, ETHER_TYPE_ARP));
 		return B_NO_MEMORY;
+	}
 
 	memset(&protocol->hardware_address, 0, sizeof(sockaddr_dl));
 	protocol->local_address = 0;
@@ -1003,6 +1037,8 @@
 status_t
 arp_uninit_protocol(net_datalink_protocol *protocol)
 {
+	arp_remove_protocol_entries((arp_protocol*)protocol);
+
 	sStackModule->unregister_device_handler(protocol->interface->device,
 		B_NET_FRAME_TYPE(IFT_ETHER, ETHER_TYPE_ARP));
 	sStackModule->unregister_device_handler(protocol->interface->device,
