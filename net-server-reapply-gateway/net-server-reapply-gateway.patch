+status_t
+NetServer::_RestoreStaticRoutes(const char* name)
+{
+	BMessage interface;
+	if (fSettings.GetInterface(name, interface) != B_OK)
+		return B_NAME_NOT_FOUND;
+
+	bool disabled = false;
+	if (interface.FindBool("disabled", &disabled) == B_OK && disabled)
+		return B_OK;
+
+	BNetworkInterface nic(name);
+	if (!nic.Exists() || (nic.Flags() & IFF_UP) == 0)
+		return B_OK;
+
+	BMessage addressMessage;
+	for (int32 index = 0; interface.FindMessage("address", index,
+			&addressMessage) == B_OK; index++) {
+		BNetworkInterfaceAddressSettings addressSettings(addressMessage);
+		if (addressSettings.IsAutoConfigure()
+			|| addressSettings.Gateway().IsEmpty())
+			continue;
+
+		BNetworkAddress current;
+		if (nic.GetDefaultGateway(addressSettings.Family(), current) == B_OK
+			&& current == addressSettings.Gateway())
+			continue;
+
+		nic.RemoveDefaultRoute(addressSettings.Family());
+		status_t status = nic.AddDefaultRoute(addressSettings.Gateway());
+		if (status != B_OK) {
+			fprintf(stderr, "%s: Could not restore route for %s: %s\n",
+				Name(), name, strerror(status));
+		}
+	}
+
+	return B_OK;
+}
