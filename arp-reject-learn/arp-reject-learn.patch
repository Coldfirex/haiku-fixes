From: Alan Shearer
Subject: arp: undo handler register if init fails

Init registers the ARP handler, then the IPv4 handler, then
allocates the protocol. If a later step fails, the handlers
are left registered.

Uninit also deleted the protocol while cache entries still
pointed at it.

Unregister the handlers if init fails. On uninit, remove
cache entries that belong to this protocol.

---
 src/add-ons/kernel/network/datalink_protocols/arp/arp.cpp | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/src/add-ons/kernel/network/datalink_protocols/arp/arp.cpp b/src/add-ons/kernel/network/datalink_protocols/arp/arp.cpp
--- a/src/add-ons/kernel/network/datalink_protocols/arp/arp.cpp
+++ b/src/add-ons/kernel/network/datalink_protocols/arp/arp.cpp
@@ -401,6 +401,16 @@
 
 		entry->hardware_address = *hardwareAddress;
 		entry->timestamp = system_time();
+
+		// Incoming packets pass flags == 0. A non-permanent reject must
+		// not stick once we have a mapping for that protocol address.
+		if ((entry->flags & ARP_FLAG_PERMANENT) == 0
+			&& (flags & ARP_FLAG_REJECT) == 0) {
+			entry->flags &= ~ARP_FLAG_REJECT;
+		}
+
+		entry->flags |= flags & (ARP_FLAG_PUBLISH | ARP_FLAG_PERMANENT
+			| ARP_FLAG_REJECT);
 	} else {
 		entry = arp_entry::Add(protocolAddress, hardwareAddress, flags);
 		if (entry == NULL)
@@ -609,6 +619,9 @@
 	buffer->msg_flags = 0;
 		// make sure this won't be a broadcast message
 
+	// Reader may hold a copy if the header was not directly accessible.
+	gBufferModule->write(buffer, 0, &header, sizeof(arp_header));
+
 	gBufferModule->trim(buffer, sizeof(arp_header));
 	return entry->protocol->next->module->send_data(entry->protocol->next,
 		buffer);
