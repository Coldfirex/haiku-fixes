From: Alan Shearer
Subject: ipv4: put multicast route and interface references

get_multicast_interface() calls get_route() and returns the route's
interface without put_route(). ipv4_delta_membership() and
ipv4_generic_delta_membership() call get_interface() /
get_interface_with_address() and never put_interface(). The file
already notes both leaks.

Take an interface reference, drop the route, and put_interface() on
every exit of the two wrappers.

---
 src/add-ons/kernel/network/protocols/ipv4/ipv4.cpp | 16 ++++++++++------
 1 file changed, 10 insertions(+), 6 deletions(-)

diff --git a/src/add-ons/kernel/network/protocols/ipv4/ipv4.cpp b/src/add-ons/kernel/network/protocols/ipv4/ipv4.cpp
--- a/src/add-ons/kernel/network/protocols/ipv4/ipv4.cpp
+++ b/src/add-ons/kernel/network/protocols/ipv4/ipv4.cpp
@@ -997,14 +997,16 @@
 static net_interface*
 get_multicast_interface(ipv4_protocol* protocol, const in_addr* address)
 {
-	// TODO: this is broken and leaks references
 	sockaddr_in groupAddr;
 	net_route* route = sDatalinkModule->get_route(sDomain,
 		fill_sockaddr_in(&groupAddr, address ? address->s_addr : INADDR_ANY));
 	if (route == NULL)
 		return NULL;
 
-	return route->interface_address->interface;
+	net_interface* interface = sDatalinkModule->get_interface(sDomain,
+		route->interface_address->interface->index);
+	sDatalinkModule->put_route(sDomain, route);
+	return interface;
 }
 
 
@@ -1025,8 +1027,10 @@
 	if (interface == NULL)
 		return B_DEVICE_NOT_FOUND;
 
-	return ipv4_delta_membership(protocol, option, interface,
+	status_t status = ipv4_delta_membership(protocol, option, interface,
 		groupAddr, sourceAddr);
+	sDatalinkModule->put_interface(interface);
+	return status;
 }
 
 
@@ -1041,7 +1045,6 @@
 
 	const in_addr* groupAddr = &((const sockaddr_in*)_groupAddr)->sin_addr;
 
-	// TODO: this is broken and leaks references
 	net_interface* interface;
 	if (index == 0)
 		interface = get_multicast_interface(protocol, groupAddr);
@@ -1055,7 +1058,9 @@
 	if (_sourceAddr != NULL)
 		sourceAddr = &((const sockaddr_in*)_sourceAddr)->sin_addr;
 
-	return ipv4_delta_membership(protocol, generic_to_ipv4(option), interface,
-		groupAddr, sourceAddr);
+	status_t status = ipv4_delta_membership(protocol, generic_to_ipv4(option),
+		interface, groupAddr, sourceAddr);
+	sDatalinkModule->put_interface(interface);
+	return status;
 }
 
