From: Alan Shearer <sakison@gmail.com>
Date: Tue, 13 Oct 2026 11:00:00 -0500
Subject: mail_utils: fix spelling in error messages

Fix "occured" to "occurred".

No functional change.

diff --git a/src/bin/mail_utils/mail2mbox.cpp b/src/bin/mail_utils/mail2mbox.cpp
--- a/src/bin/mail_utils/mail2mbox.cpp
+++ b/src/bin/mail_utils/mail2mbox.cpp
@@ -48,7 +48,7 @@
 	if (errorNumber != 0) {
 		snprintf(errorBuffer, sizeof(errorBuffer), "%s: %s (%" B_PRIx32 ")"
-			"has occured.", messageString, strerror(errorNumber), errorNumber);
+			"has occurred.", messageString, strerror(errorNumber), errorNumber);
 		messageString = errorBuffer;
 	}
 
@@ -340,7 +340,7 @@
 	closedir(dir);
 
 	if (status != B_OK) {
-		DisplayErrorMessage("Stopping early because an error occured", status);
+		DisplayErrorMessage("Stopping early because an error occurred", status);
 		return status;
 	}
diff --git a/src/bin/mail_utils/mbox2mail.cpp b/src/bin/mail_utils/mbox2mail.cpp
--- a/src/bin/mail_utils/mbox2mail.cpp
+++ b/src/bin/mail_utils/mbox2mail.cpp
@@ -78,7 +78,7 @@
   if (ErrorNumber != 0)
   {
-    sprintf (ErrorBuffer, "%s, error code $%X/%d (%s) has occured.",
+    sprintf (ErrorBuffer, "%s, error code $%X/%d (%s) has occurred.",
       MessageString, ErrorNumber, ErrorNumber, strerror (ErrorNumber));
     MessageString = ErrorBuffer;
   }
