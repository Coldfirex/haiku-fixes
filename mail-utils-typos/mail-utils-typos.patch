From: Alan Shearer <sakison@gmail.com>
Date: Tue, 13 Oct 2026 16:40:00 -0500
Subject: mail_utils: fix spelling in error messages

Fix "occured" to "occurred" and "misssing" to "missing".

diff --git a/src/bin/mail_utils/mail2mbox.cpp b/src/bin/mail_utils/mail2mbox.cpp
--- a/src/bin/mail_utils/mail2mbox.cpp	2026-10-13 21:35:55.007508502 +0000
+++ b/src/bin/mail_utils/mail2mbox.cpp	2026-10-13 21:35:55.471508522 +0000
@@ -55,8 +55,8 @@
 	}
 
 	if (errorNumber != 0) {
-		snprintf(errorBuffer, sizeof(errorBuffer), "%s: %s (%" B_PRIx32 ")"
-			"has occured.", messageString, strerror(errorNumber), errorNumber);
+		snprintf(errorBuffer, sizeof(errorBuffer), "%s: %s (%" B_PRIx32 ") has occurred.",
+			messageString, strerror(errorNumber), errorNumber);
 		messageString = errorBuffer;
 	}
 
@@ -354,7 +354,7 @@
 	closedir(dir);
 
 	if (status != B_OK) {
-		DisplayErrorMessage("Stopping early because an error occured", status);
+		DisplayErrorMessage("Stopping early because an error occurred", status);
 		return status;
 	}
 

diff --git a/src/bin/mail_utils/mbox2mail.cpp b/src/bin/mail_utils/mbox2mail.cpp
--- a/src/bin/mail_utils/mbox2mail.cpp	2026-10-13 21:35:55.431508520 +0000
+++ b/src/bin/mail_utils/mbox2mail.cpp	2026-10-13 21:35:55.471508522 +0000
@@ -99,8 +99,8 @@
 
   if (ErrorNumber != 0)
   {
-    sprintf (ErrorBuffer, "%s, error code $%X/%d (%s) has occured.",
-      MessageString, ErrorNumber, ErrorNumber, strerror (ErrorNumber));
+    sprintf(ErrorBuffer, "%s, error code $%X/%d (%s) has occurred.", MessageString, ErrorNumber,
+        ErrorNumber, strerror(ErrorNumber));
     MessageString = ErrorBuffer;
   }
 
@@ -312,7 +312,7 @@
 
   if (memcmp ("of ", StringPntr, 3) != 0)
   {
-    printf ("False alarm, article line \"of\" misssing in \"%s\".\n",
+    printf ("False alarm, article line \"of\" missing in \"%s\".\n",
       LineString);
     return false;
   }
