From e7101101934274ecc9779c5e8f6e93f708c829ff Mon Sep 17 00:00:00 2001
From: Alan Shearer <Coldfirex@users.noreply.github.com>
Date: Sun, 4 Oct 2026 20:45:00 -0500
Subject: [PATCH] net_server: read saved network name from the network block

_ConfigureInterface() walks the network messages on an interface, then
reads name and mac from the interface message. That message has device,
not name, so the join gets a null name.

Read those two fields from the network message instead. The parent
message is still passed in, because _JoinNetwork() needs device.

---
 src/servers/net/NetServer.cpp | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/servers/net/NetServer.cpp b/src/servers/net/NetServer.cpp
--- a/src/servers/net/NetServer.cpp
+++ b/src/servers/net/NetServer.cpp
@@ -548,8 +548,8 @@ NetServer::_ConfigureInterface(BMessage& message)
 	BMessage networkMessage;
 	for (int32 index = 0; message.FindMessage("network", index,
 			&networkMessage) == B_OK; index++) {
-		const char* networkName = message.GetString("name", NULL);
-		const char* addressString = message.GetString("mac", NULL);
+		const char* networkName = networkMessage.GetString("name", NULL);
+		const char* addressString = networkMessage.GetString("mac", NULL);
 
 		BNetworkAddress address;
 		status_t addressStatus = address.SetTo(AF_LINK, addressString);
