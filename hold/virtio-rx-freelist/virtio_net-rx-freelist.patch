From: Alan Shearer
Subject: virtio_net: keep RX BufInfo if enqueue fails

RX BufInfos live on the virtqueue or on rxFullList. After a frame is
copied, receive() calls queue_request_v() again. On failure the slot
was not queued and not on rxFullList, so that descriptor was lost
until close. open() also ignored enqueue errors.

Park a failed BufInfo on rxFreeList and retry from receive(). Do not
put it back on rxFullList; that would deliver the same frame twice.

---
 src/add-ons/kernel/drivers/network/ether/virtio/virtio_net.cpp | 24 ++++++++++++++++++++----
 1 file changed, 20 insertions(+), 4 deletions(-)

diff --git a/src/add-ons/kernel/drivers/network/ether/virtio/virtio_net.cpp b/src/add-ons/kernel/drivers/network/ether/virtio/virtio_net.cpp
--- a/src/add-ons/kernel/drivers/network/ether/virtio/virtio_net.cpp
+++ b/src/add-ons/kernel/drivers/network/ether/virtio/virtio_net.cpp
@@ -73,6 +73,7 @@
 	BufInfo**				rxBufInfos;
 	sem_id					rxDone;
 	area_id					rxArea;
 	BufInfoList				rxFullList;
+	BufInfoList				rxFreeList;
 	mutex					rxLock;
 
 	::virtio_queue*			txQueues;
@@ -190,8 +191,11 @@
 		info->txFreeList.Add(buf);
 
-	while (info->virtio->queue_dequeue(info->rxQueues[0], NULL, NULL))
-		;
+	buf = NULL;
+	while (info->virtio->queue_dequeue(info->rxQueues[0], (void**)&buf, NULL)) {
+		if (buf != NULL)
+			info->rxFreeList.Add(buf);
+	}
 
 	while (info->rxFullList.RemoveHead() != NULL)
 		;
@@ -561,8 +565,12 @@
 		dprintf("virtio_net: no mtu feature\n");
 	}
 
-	for (int i = 0; i < info->rxSizes[0]; i++)
-		virtio_net_rx_enqueue_buf(info, info->rxBufInfos[i]);
+	for (int i = 0; i < info->rxSizes[0]; i++) {
+		if (virtio_net_rx_enqueue_buf(info, info->rxBufInfos[i]) != B_OK)
+			info->rxFreeList.Add(info->rxBufInfos[i]);
+	}
 
 	*_cookie = handle;
 	return B_OK;
@@ -669,8 +677,16 @@
 	}
 	const uint8_t flags = buf->hdr->flags;
 	rxLocker.Lock();
-	virtio_net_rx_enqueue_buf(info, buf);
+	if (virtio_net_rx_enqueue_buf(info, buf) != B_OK)
+		info->rxFreeList.Add(buf);
+	while ((buf = info->rxFreeList.RemoveHead()) != NULL) {
+		if (virtio_net_rx_enqueue_buf(info, buf) != B_OK) {
+			info->rxFreeList.Add(buf);
+			break;
+		}
+	}
 	rxLocker.Unlock();
 
 	if (buffer == NULL)
 		return B_NO_MEMORY;
